{
  "openapi": "3.1.1",
  "info": {
    "title": "SupportTriage.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:51053/"
    }
  ],
  "paths": {
    "/api/v1/tickets": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Create ticket",
        "description": "Stores a support ticket for the tenant in the X-Tenant-Id header and returns 202 Accepted with status Pending at once; a background worker then classifies it (category and priority). Card numbers and security codes are masked before the ticket is stored. Fails with 400 when the email is missing or invalid, when both subject and body are empty, when a field is too long, or when the X-Tenant-Id header is missing or invalid.",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Tenant the request works in: 1-64 lowercase letters, digits and dashes (for example contoso).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTicketRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketCreatedDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              },
              "application/json": {}
            }
          }
        }
      },
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "List tickets",
        "description": "Lists the tenant's tickets with their classification, newest first. Tickets that are still being triaged have status Pending or Processing and no category or priority yet; when an attempt failed, failureReason and failureMessage say why and that it will be retried. Tickets whose triage gave up (status Failed, isHidden true) are left out unless includeHidden is true, so an operator can find and classify them; their failureMessage explains why. category and priority can be repeated (category=Billing&category=Technical) and keep only tickets with one of the given values; tickets without a classification yet are left out by these filters. Values are the exact names Billing, Technical, Account, Shipping, Other and Low, Medium, High, Critical. Pass the returned continuationToken with the same filters to get the next page; pageSize defaults to 20 and is clamped to 1-100. Fails with 400 when a category or priority is not an allowed name, when the continuation token is not valid, or when the X-Tenant-Id header is missing or invalid.",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "continuationToken",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "includeHidden",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Tenant the request works in: 1-64 lowercase letters, digits and dashes (for example contoso).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContinuationPageDtoOfTicketDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/v1/tickets/{ticketId}": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "Get ticket",
        "description": "Returns one of the tenant's tickets with its classification, and failureReason and failureMessage when triage failed. A ticket whose triage gave up (isHidden true) is returned only when includeHidden is true. Fails with 404 when the ticket does not exist in this tenant or is hidden and includeHidden is false, and with 400 when the X-Tenant-Id header is missing or invalid.",
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "name": "includeHidden",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Tenant the request works in: 1-64 lowercase letters, digits and dashes (for example contoso).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContinuationPageDtoOfTicketDto": {
        "required": [
          "items",
          "continuationToken"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketDto"
            }
          },
          "continuationToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateTicketRequest": {
        "required": [
          "customerEmail"
        ],
        "type": "object",
        "properties": {
          "customerEmail": {
            "maxLength": 254,
            "type": "string"
          },
          "subject": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "maxLength": 10000,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TicketCategory": {
        "type": "integer"
      },
      "TicketCreatedDto": {
        "required": [
          "id",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          }
        }
      },
      "TicketDto": {
        "required": [
          "id",
          "customerEmail",
          "subject",
          "body",
          "status",
          "category",
          "priority",
          "suggestedReply",
          "createdAt",
          "classifiedAt",
          "isHidden",
          "failedTriageAttempts",
          "failureReason",
          "failureMessage"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "category": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TicketCategory"
              }
            ]
          },
          "priority": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TicketPriority"
              }
            ]
          },
          "suggestedReply": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "classifiedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isHidden": {
            "type": "boolean"
          },
          "failedTriageAttempts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "failureReason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TriageFailureReason"
              }
            ]
          },
          "failureMessage": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TicketPriority": {
        "type": "integer"
      },
      "TicketStatus": {
        "type": "integer"
      },
      "TriageFailureReason": {
        "type": "integer"
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tickets"
    }
  ]
}
