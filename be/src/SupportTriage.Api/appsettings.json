{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cosmos": {
    "DatabaseName": "support-triage",
    "TicketsContainerName": "tickets"
  },
  "OpenAi": {
    "ApiKey": "",
    // Model with temperature 
    "ClassificationModel": "gpt-5.4",
    "ClassificationTemperature": 0,
    "ClassificationMaxOutputTokens": 200,
    "ScreeningModel": "gpt-5.4",
    "ScreeningMaxOutputTokens": 100,
    "MaxRetryAttempts": 4,
    "RetryBaseDelay": "00:00:01",
    "AttemptTimeout": "00:00:30",
    "TotalTimeout": "00:02:00"
  },
  "TicketTriage": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "BatchSize": 20,
    "MaxDegreeOfParallelism": 4,
    "LeaseDuration": "00:05:00",
    "MaxAttempts": 5,
    "RetryBaseDelay": "00:00:30",
    "MaxRetryDelay": "00:30:00",
    "ConfigurationErrorRetryDelay": "00:05:00"
  },
  "SeedData": {
    "ImportOnStartup": false,
    "FilePath": "seed_data.json"
  }
}
